@model IEnumerable<website.Models.Product>

@{
ViewData["Title"] = "Products";
}

<div class="container py-5">

<h1>Mycro Performance Exhaust</h1>

<p>Motorcycle Exhaust & Performance Parts</p>

<div class="mb-4">

    <form asp-action="Index" method="get" class="d-flex gap-2">

        <input type="text"
               name="searchString"
               value="@ViewData["SearchString"]"
               class="form-control"
               placeholder="Search exhaust products..." />

        <button type="submit"
                class="btn btn-dark">
            Search
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Clear
        </a>

    </form>

</div>

<a asp-action="Create" class="btn btn-dark mb-4">
    Add Product
</a>

<div class="row">

    @foreach (var product in Model)
    {
        <div class="col-md-4 mb-4">

            <div class="card">

                @if (!string.IsNullOrEmpty(product.ImageUrl))
                {
                    <img src="@product.ImageUrl"
                         alt="@product.Name"
                         class="card-img-top"
                         style="height:250px; object-fit:cover;" />
                }

                <div class="card-body">

                    <h4>@product.Name</h4>

                    <p>@product.Description</p>

                    <p>
                        <strong>Category:</strong>
                        @product.Category
                    </p>

                    <h5>
                        ₱@product.Price.ToString("N2")
                    </h5>

                </div>

                <div class="card-footer">

                    <a asp-controller="Cart"
                       asp-action="AddToCart"
                       asp-route-id="@product.Id"
                       class="btn btn-success">
                        Add to Cart
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@product.Id"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@product.Id"
                       class="btn btn-danger">
                        Delete
                    </a>

                </div>

            </div>

        </div>
    }

</div>

</div>
